# ─── SonicStream — Complete Environment Configuration ────────────────────────
# Copy to .env or .env.local and fill in your values
# NEVER commit this file to git!

# ── App ───────────────────────────────────────────────────────────────────────
NODE_ENV=development                    # development | production | test
PORT=3000                               # Server port
APP_URL=http://localhost:3000           # Public URL
FRONTEND_URL=http://localhost:3000      # Frontend URL
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://your-domain.com
SONIC_ROLE=all                          # all | api | worker | ai | migration

# ── Security ──────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your-64-char-hex-secret-here
JWT_REFRESH_SECRET=your-64-char-hex-refresh-secret-here
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
BCRYPT_ROUNDS=12

# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
COOKIE_SECRET=your-128-char-hex-cookie-secret-here

# ── Database ──────────────────────────────────────────────────────────────────
# SQLite (Development)
DATABASE_URL=sqlite:./sonicstream.db

# PostgreSQL (Production)
# DATABASE_URL=postgresql://user:password@localhost:5432/sonicstream?sslmode=require
# DATABASE_READ_URL=postgresql://user:password@read-replica:5432/sonicstream

# ── Redis ─────────────────────────────────────────────────────────────────────
# Required for BullMQ and Socket.IO
REDIS_URL=redis://localhost:6379
# REDIS_URL=rediss://:password@your-redis-host:6380

# ── Firebase (server-side admin) ────────────────────────────────────────────
# Option A: Workload Identity (Cloud Run)
# GOOGLE_APPLICATION_CREDENTIALS=

# Option B: Service Account JSON file
# GOOGLE_APPLICATION_CREDENTIALS=./firebase-service-account.json

# ── Firebase (client-side web app, from your Firebase project settings) ────────
# Required — src/firebase.ts no longer falls back to a hardcoded project.
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_MEASUREMENT_ID=
VITE_FIREBASE_DATABASE_ID=

# ── Google Cloud Storage ──────────────────────────────────────────────────────
GCS_BUCKET=sonicstream-assets-dev
GOOGLE_CLOUD_BUCKET=sonicstream-assets-dev
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_REGION=us-central1
GCS_CUSTOM_DOMAIN=                       # Optional CDN domain

# ── Stripe Payments ──────────────────────────────────────────────────────────
ENABLE_PAYMENTS=false                    # Set to true to enable payments
STRIPE_SECRET_KEY=sk_test_...            # sk_live_... for production
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_PRICE_PRO_MONTHLY=price_...
STRIPE_PRICE_PRO_ANNUAL=price_...
STRIPE_PRICE_ENTERPRISE=price_...

# ── AI Services ──────────────────────────────────────────────────────────────
GEMINI_API_KEY=your-gemini-api-key
OPENAI_API_KEY=your-openai-api-key
REPLICATE_API_TOKEN=your-replicate-token
RUNWAY_API_KEY=your-runway-api-key

# ── Email (SMTP) ─────────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com                # Or smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=your-email@gmail.com          # Or 'apikey' for SendGrid
SMTP_PASS=your-app-password             # Or API key
EMAIL_FROM=SonicStream <noreply@sonicstream.io>

# ── SMS (Twilio) ─────────────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=your-auth-token
TWILIO_FROM_NUMBER=+15555555555         # E.164 format

# ── ISRC + UPC ────────────────────────────────────────────────────────────────
ISRC_COUNTRY_CODE=US
ISRC_REGISTRANT_CODE=SS1
GS1_COMPANY_PREFIX=884977

# ── Observability ────────────────────────────────────────────────────────────
SENTRY_DSN=https://xxx@yyy.ingest.sentry.io/zzz
LOG_LEVEL=info                          # debug | info | warn | error

# ── Feature Flags ────────────────────────────────────────────────────────────
ENABLE_RSS_AUTOMATION=true
ENABLE_AI_WORKERS=true
ENABLE_PLATFORM_BRAIN=true
ENABLE_RECOMMENDATIONS=true
RUN_BOOTSTRAP=true

# ── Frontend Feature Flags ──────────────────────────────────────────────────
VITE_FEATURE_AI_STUDIO=true
VITE_FEATURE_VIDEO=true
VITE_FEATURE_AFFILIATE=true
VITE_FEATURE_PLUGINS=true

# ── Social Integrations ──────────────────────────────────────────────────────
TIKTOK_CLIENT_KEY=your-tiktok-key
SPOTIFY_CLIENT_ID=your-spotify-id
SPOTIFY_CLIENT_SECRET=your-spotify-secret

# ── Performance ──────────────────────────────────────────────────────────────
SLOW_QUERY_THRESHOLD_MS=200
MIN_BITRATE_KBPS=128
MIN_DYNAMIC_RANGE=2
HIGHLIGHT_ACTIVITY_THRESHOLD=10
MAX_UPLOAD_SIZE_MB=100
