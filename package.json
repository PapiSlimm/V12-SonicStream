{
  "name": "v12-sonicstream",
  "version": "12.0.0",
  "type": "module",
  "description": "The Business Operating System for All Creators",
  "main": "dist/server.cjs",
  "scripts": {
    "dev": "tsx server.ts",
    "dev:client": "vite",
    "dev:server": "tsx server.ts",
    "dev:all": "concurrently \"npm run dev:client\" \"npm run dev:server\"",
    "build": "npm run build:clean && npm run build:client && npm run build:server && npm run build:worker && npm run build:scheduler",
    "build:clean": "rm -rf dist",
    "build:client": "vite build",
    "build:server": "esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "build:worker": "esbuild server/worker.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/worker.cjs",
    "build:analyze": "vite build --mode analyze",
    "start": "NODE_ENV=production node dist/server.cjs",
    "start:dev": "NODE_ENV=development node dist/server.cjs",
    "worker": "NODE_ENV=production SONIC_ROLE=worker node dist/worker.cjs",
    "ai": "NODE_ENV=production SONIC_ROLE=ai node dist/server.cjs",
    "api": "NODE_ENV=production SONIC_ROLE=api node dist/server.cjs",
    "migrate": "tsx scripts/migrate.ts",
    "seed": "tsx scripts/seed.ts",
    "setup": "bash scripts/setup.sh",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest --coverage",
    "lint": "eslint . --ext .ts,.tsx",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "format": "prettier --write '**/*.{ts,tsx,js,json,md}'",
    "typecheck": "tsc --noEmit",
    "env:validate": "tsx scripts/validate-env.ts",
    "env:generate": "bash scripts/generate-env.sh",
    "health": "curl http://localhost:3000/health/live",
    "docker:build": "docker build -t sonicstream .",
    "docker:run": "docker run -p 3000:3000 --env-file .env sonicstream",
    "deploy:api": "bash scripts/deploy-cloud-run.sh api",
    "deploy:worker": "bash scripts/deploy-cloud-run.sh worker",
    "deploy:ai": "bash scripts/deploy-cloud-run.sh ai",
    "deploy:all": "bash scripts/deploy-cloud-run.sh all",
    "postinstall": "npm run build",
    "build:scheduler": "esbuild server/scheduler.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/scheduler.cjs",
    "start:scheduler": "NODE_ENV=production node dist/scheduler.cjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1069.0",
    "@dnd-kit/core": "^6.1.0",
    "@dnd-kit/sortable": "^8.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@google-cloud/secret-manager": "^5.6.0",
    "@google-cloud/storage": "^5.18.3",
    "@google/genai": "^2.8.0",
    "@google/generative-ai": "^0.24.1",
    "@react-pdf/renderer": "^3.4.4",
    "@react-three/drei": "^9.114.3",
    "@react-three/fiber": "^8.17.10",
    "@sentry/node": "^10.69.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "@stripe/react-stripe-js": "^2.7.3",
    "@stripe/stripe-js": "^3.4.1",
    "@tanstack/react-query": "^5.50.1",
    "@types/qrcode": "^1.5.6",
    "axios": "^1.7.2",
    "bullmq": "^5.8.5",
    "clsx": "^2.1.1",
    "compression": "^1.7.4",
    "connect-redis": "^9.0.0",
    "cors": "^2.8.5",
    "dashjs": "^4.7.4",
    "date-fns": "^3.6.0",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-async-errors": "^3.1.1",
    "express-rate-limit": "^7.3.1",
    "express-session": "^1.19.0",
    "file-saver": "^2.0.5",
    "firebase": "^10.12.2",
    "firebase-admin": "^14.2.0",
    "fluent-ffmpeg": "^2.1.3",
    "framer-motion": "^11.2.10",
    "helmet": "^7.1.0",
    "hls.js": "^1.5.17",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.2",
    "lru-cache": "^10.2.2",
    "lucide-react": "^0.395.0",
    "motion": "^11.11.17",
    "multer": "^1.4.5-lts.1",
    "multer-s3": "^3.0.1",
    "nodemailer": "^9.0.5",
    "openai": "^4.52.1",
    "opossum": "^8.3.0",
    "pg": "^8.12.0",
    "pino": "^9.2.0",
    "pino-pretty": "^11.0.0",
